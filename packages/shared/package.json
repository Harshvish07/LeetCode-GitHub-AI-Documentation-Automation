{
  "name": "@codereviewai/shared",
  "version": "0.3.0",
  "private": true,
  "description": "Shared TypeScript types and small pure utilities used by apps/web, apps/api and apps/extension.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
