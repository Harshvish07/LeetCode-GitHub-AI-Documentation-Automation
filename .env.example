# -----------------------------------------------------------------------------
# CodeReviewAI — environment variables
# Copy this file to `.env` in apps/api (or the repo root, depending on your
# tooling) and fill in real values. Never commit the real `.env` file.
# -----------------------------------------------------------------------------

# apps/api -----------------------------------------------------------------
# Port the Express server listens on.
PORT=4000

# Standard Node environment flag.
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (CORS).
# The Vite dev server for apps/web runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# AI integration (Phase 5) --------------------------------------------------
# API key for the Anthropic Messages API, used by POST /api/submissions/:id/review
# to generate an AI-powered solution review. Required only for that one
# endpoint — the rest of the API works fully without it. Server-side only:
# never sent to, or readable by, the extension or web frontend.
# Get one at https://console.anthropic.com/settings/keys
# AI_PROVIDER_API_KEY=

# Which Claude model to call. Optional — defaults to claude-sonnet-5 if unset.
# AI_PROVIDER_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# The variable below is NOT used yet. It is a placeholder for a feature
# planned in a later phase and is documented here so the full configuration
# surface is visible up front. Do not remove it; do not implement the
# feature that consumes it ahead of its phase.
# -----------------------------------------------------------------------------

# Phase 7+ (GitHub integration): OAuth app / token used to commit generated
# learning documents to the user's GitHub repository.
# GITHUB_TOKEN=
# GITHUB_REPO=
