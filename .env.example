# -----------------------------------------------------------------------------
# CodeReviewAI — environment variables
# Copy this file to `.env` in apps/api (or the repo root, depending on your
# tooling) and fill in real values. Never commit the real `.env` file.
# -----------------------------------------------------------------------------

# apps/api -----------------------------------------------------------------
# Port the Express server listens on.
PORT=4000

# Standard Node environment flag.
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (CORS).
# The Vite dev server for apps/web runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# AI integration (Phase 5) --------------------------------------------------
# Which AI vendor to call for POST /api/submissions/:id/review. Optional —
# defaults to "anthropic" if unset. Supported values: "anthropic" | "gemini".
# AI_PROVIDER=anthropic

# API key for the selected provider (Anthropic Messages API or Google Gemini
# API, depending on AI_PROVIDER above), used by POST /api/submissions/:id/review
# to generate an AI-powered solution review. Required only for that one
# endpoint — the rest of the API works fully without it. Server-side only:
# never sent to, or readable by, the extension or web frontend.
# Anthropic keys: https://console.anthropic.com/settings/keys
# Gemini keys: https://aistudio.google.com/apikey
# AI_PROVIDER_API_KEY=

# Which model to call. Optional — defaults to claude-sonnet-5 (Anthropic) or
# gemini-3.6-flash (Gemini) if unset.
# AI_PROVIDER_MODEL=

# Database (Phase 8) ---------------------------------------------------------
# PostgreSQL connection string for the dashboard's persistence layer. Optional —
# without it the API runs exactly as before (in-memory submissions) and the
# dashboard endpoints answer 503 DATABASE_NOT_CONFIGURED. Migrations run
# automatically at startup, or on demand with: npm run db:migrate -w @codereviewai/api
# Never commit a real connection string; it contains the database password.
# DATABASE_URL=postgres://codereviewai:YOUR_PASSWORD@localhost:5432/codereviewai

# Supabase: Project Settings > Database > Connection string (URI). Use the direct
# connection, or the "Session pooler" one if your network is IPv4-only. Put your
# database password in it; never commit it.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# TLS. Optional: on by default for *.supabase.co / *.supabase.com hosts; set "true" for
# other hosted Postgres that requires it, or "false" to force it off.
# DATABASE_SSL=false

# Only used by docker-compose.yml to create the local dev database's password
# (read from your shell or a root .env file — never stored in the compose file).
# POSTGRES_PASSWORD=

# GitHub integration (Phase 7) -----------------------------------------------
# A personal access token (classic or fine-grained, with "Contents" read/write
# on the target repo) used by POST /api/submissions/:id/publish to commit
# generated learning documents. Required only for that one endpoint — the
# rest of the API works fully without it. Server-side only: never sent to, or
# readable by, the extension or web frontend. This is the MVP token-based
# auth provider; a future OAuth flow would be a different GitHubAuthProvider
# implementation, not a change to this variable. See docs/github-integration.md.
# Create one at https://github.com/settings/tokens
# GITHUB_TOKEN=

# The target repository to publish into, as "owner/repo" (e.g. "octocat/leetcode-ai-journal").
# GITHUB_REPO=
