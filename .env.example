# -----------------------------------------------------------------------------
# CodeReviewAI — environment variables
# Copy this file to `.env` in apps/api (or the repo root, depending on your
# tooling) and fill in real values. Never commit the real `.env` file.
# -----------------------------------------------------------------------------

# apps/api -----------------------------------------------------------------
# Port the Express server listens on.
PORT=4000

# Standard Node environment flag.
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (CORS).
# The Vite dev server for apps/web runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# The variables below are NOT used yet. They are placeholders for features
# planned in later phases and are documented here so the full configuration
# surface is visible up front. Do not remove them; do not implement the
# features that consume them during Phase 1.
# -----------------------------------------------------------------------------

# Phase 5+ (AI integration): API key for the LLM provider used to analyze
# submitted solutions.
# AI_PROVIDER_API_KEY=

# Phase 7+ (GitHub integration): OAuth app / token used to commit generated
# learning documents to the user's GitHub repository.
# GITHUB_TOKEN=
# GITHUB_REPO=
